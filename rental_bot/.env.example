# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=
# Path to the Google service-account JSON key
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# The long ID from the spreadsheet URL: docs.google.com/spreadsheets/d/<ID>/edit
SPREADSHEET_ID=
# Tab to write to (created if missing)
WORKSHEET_NAME=Rentals
# Used to resolve "tomorrow at 6" etc.
TIMEZONE=Asia/Jerusalem
# Optional: comma-separated chat IDs allowed to use the bot (empty = anyone)
ALLOWED_CHAT_IDS=
